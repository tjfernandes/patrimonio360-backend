# Copiar para .env (nesta pasta) quando as ferramentas correm sem o backend ao lado.
# Mesmos nomes que o backend/.env do assistente.
OPENSEARCH_HOST=https://patrimonio360.webredirect.org
OPENSEARCH_PORT=9201
OPENSEARCH_SCHEME=https
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
