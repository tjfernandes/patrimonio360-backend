# Modelo do .env do backend do Património 360.
#
# Tem todas as chaves do .env de produção desta máquina (28/09/2026), com os mesmos
# valores, exceto as credenciais, que ficam vazias e têm de ser preenchidas:
#   OPENSEARCH_USERNAME, OPENSEARCH_PASSWORD, LLM_API_KEY e OPENROUTER_API_KEY
#   (OPENROUTER_API_KEY só é precisa com USE_OPENROUTER_BGE_M3=true).
#
#   cp .env.example .env      # o .env nunca vai para o git

APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true
LOG_JSON_PRETTY=true
LOG_JSON_INDENT=2
LOG_CHAT_MESSAGES=false
LOG_CHAT_STATE_HISTORY=false
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
DEBUG_EMBEDDINGS=true
BACKEND_LOG_ENABLED=true
BACKEND_LOG_LEVEL=INFO
BACKEND_ACCESS_LOG_ENABLED=true
BACKEND_LOG_HEALTHCHECKS=false

OPENSEARCH_HOST=https://patrimonio360.webredirect.org
OPENSEARCH_PORT=9201
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_SCHEME=https
# Leave empty to mirror Indexer behavior (auto true when username/password exist)
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_SSL_SHOW_WARN=false

OPENSEARCH_INDEX_ARTIFACT=cultural_heritage_artifacts_v4
OPENSEARCH_INDEX_IMAGE=cultural_heritage_images_v4
OPENSEARCH_INDEX_MUSEUM=cultural_heritage_museums_v1
OPENSEARCH_INDEX_AUTOR=cultural_heritage_authors_v4
OPENSEARCH_INDEX_CONJUNTO=cultural_heritage_sets_v4
OPENSEARCH_INDEX_EXPOSICAO=cultural_heritage_exhibitions_v4

ARTIFACT_TEXT_EMBEDDING_DIMENSION=4096
ARTIFACT_MULTIMODAL_EMBEDDING_DIMENSION=2048
MUSEUM_TEXT_EMBEDDING_DIMENSION=2560
IMAGE_MULTIMODAL_EMBEDDING_DIMENSION=4096

QWEN_TEXT_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-8B
USE_OPENROUTER_BGE_M3=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_BGE_MODEL=baai/bge-m3
QWEN_MULTIMODAL_EMBEDDING_MODEL_ID=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_PREFER_BF16=true
EMBEDDING_MAX_LENGTH=2048
TEXT_EMBEDDING_BATCH_SIZE=2

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8004/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=carminho/AMALIA-9B-50-DPO

LLM_TEMPERATURE_TEXT=0.4
LLM_TEMPERATURE_JSON=0.0
LLM_MAX_TOKENS=0
LLM_TIMEOUT_SECONDS=60

CHAT_HISTORY_WINDOW=8
CHAT_SESSION_TTL_SECONDS=3600
CHAT_ROLLING_SUMMARY_MAX_CHARS=600
CHAT_ENABLE_RAG=true
CHAT_USE_QUERY_EMBEDDINGS=true
CHAT_RETRIEVAL_TOP_K=8
CHAT_RETRIEVAL_RESULTS_PAGE_SIZE=8
CHAT_INCLUDE_ORIGIN_HISTORY_IN_LLM_CONTEXT=false
CHAT_ENABLE_RERANKING=false
RERANKER_MODEL_ID=Qwen/Qwen3-Reranker-8B
RERANKER_MODEL_REVISION=77d193c791ed757ca307ee72715aa132723da912
RERANKER_MAX_LENGTH=1024
RERANKER_BATCH_SIZE=10
RERANKER_CANDIDATES=24

CHAT_IMAGE_RETRIEVAL_TOP_K=8
CHAT_IMAGE_ARTIFACT_TOP_K=8
CHAT_IMAGE_DEFAULT_MESSAGE=Analisa a imagem e identifica a peça mais provável no museu.
IMAGE_ASSET_ROOT=Images
CHAT_ENABLE_STRUCTURED_QUERY_PLANNING=true
CHAT_ANALYTICS_PLANNER_MIN_CONFIDENCE=0.55
CHAT_ANALYTICS_LIST_TOP_K=8
CHAT_RETRIEVAL_EMBEDDING_ONLY=false
CHAT_RETRIEVAL_CANDIDATES=8
CHAT_RETRIEVAL_PAGINATION_WINDOW=1000
CHAT_IMAGE_RETRIEVAL_PAGINATION_WINDOW=150
CHAT_IN_TOUR_BOOST=0
IMAGE_IN_TOUR_BOOST=0.05

# off    -> comportamento atual (sem ramo visual, sem alteração de ranking)
# intent -> texto→imagem apenas quando a intenção visual é identificada
# always -> texto→imagem em todas as pesquisas textuais (avaliação/benchmark)
# Floor de score do ramo visual antes da fusão (0.0 = sem floor; o valor
# conservador definitivo é calibrado empiricamente na Etapa 5 da Fase 3).
RERANKER_INSTRUCTION=Given a museum visitor query, retrieve museum artifact records relevant to the query
RERANKER_PREFER_BF16=true

# Reranker visual (2a fase i2i/imagem+texto; Qwen3-VL-Reranker-8B)
CHAT_ENABLE_VL_RERANKING=false
VL_RERANKER_MODEL_ID=Qwen/Qwen3-VL-Reranker-8B
VL_RERANKER_MODEL_REVISION=b212dc8c91a8164aef1ea2de9c1a867611e75c04
VL_RERANKER_INSTRUCTION=Given a user query (image and/or text), retrieve museum artifact images that match the queried object
VL_RERANKER_BATCH_SIZE=4
VL_RERANKER_CANDIDATES=16
VL_RERANKER_MAX_IMAGE_SIDE=1024
CHAT_MODEL_DEFAULT_MESSAGE=Analisa este modelo 3D e identifica a peca mais provavel no museu.
CHAT_MODEL_FIRST_PASS_VIEWS=3
CHAT_MODEL_TOTAL_VIEWS=8
CHAT_MODEL_LOW_CONFIDENCE_SCORE_THRESHOLD=0.35
CHAT_MODEL_CACHE_SIZE=12
POI_TOURS_DIR=
MULTIVIEW_WORKER_HOST=127.0.0.1
MULTIVIEW_WORKER_PORT=3101
MULTIVIEW_WORKER_START_TIMEOUT_SECONDS=30
MULTIVIEW_RENDER_SIZE=512
MULTIVIEW_RENDER_BACKGROUND="#FFFFFF"
MULTIVIEW_RENDER_FOV=35
MULTIVIEW_RENDER_DPR=1.0
MULTIVIEW_RENDER_STRATEGY=adaptive
MULTIVIEW_RENDER_OVERSAMPLE=320
MULTIVIEW_RENDER_ORBIT_MARGIN=1.35
MULTIVIEW_RENDER_ENSURE_TOP=true
MULTIVIEW_RENDER_DELAY_MS=8
MULTIVIEW_SAVE_LAST_VIEWS=true
MULTIVIEW_LAST_VIEWS_DIR=tmp/multiview_last_views

QUERY_LOG_ENABLED=true
QUERY_LOG_PATH=logs/production/backend_queries.jsonl
FRONTEND_EVENT_LOG_PATH=logs/production/frontend_events.jsonl

# --- v4/8B cutover (2026-07-13) ---
QWEN_TEXT_EMBEDDING_MODEL_REVISION=1d8ad4ca9b3dd8059ad90a75d4983776a23d44af
QWEN_MULTIMODAL_EMBEDDING_MODEL_REVISION=2c4565515e0f265c6511776e7193b22c0968ddc7

# --- Fase 3: retrieval multimodal (off = comportamento atual) ---
MULTIMODAL_RETRIEVAL_MODE=intent
MULTIMODAL_RRF_K=60
MULTIMODAL_ARTIFACT_WEIGHT=1.0
MULTIMODAL_IMAGE_WEIGHT=0.7
MULTIMODAL_MIN_IMAGE_SCORE=0.64
MULTIMODAL_IMAGE_TOP_K=30
# Pesos da fusão imagem+texto (i2i é o ramo principal).
MULTIMODAL_I2I_WEIGHT=1.0
MULTIMODAL_IMAGE_TEXT_ARTIFACT_WEIGHT=0.5
# E9: ramos múltiplos via _msearch (fallback automático). E10: margem
# in_tour pós-fusão (0.0 = desligada; sobe no máx. 1 posição).
MULTIMODAL_USE_MSEARCH=true
MULTIMODAL_IN_TOUR_MARGIN=0.0
MULTIMODAL_DEBUG=false

# --- Fase 3 E14: ramo conjunto imagem+texto + rerank VL global (Joint image+text branch) ---
MULTIMODAL_JOINT_IMAGE_TEXT_ENABLED=true
MULTIMODAL_JOINT_IMAGE_TEXT_TOP_K=30
MULTIMODAL_JOINT_IMAGE_TEXT_WEIGHT=1.0
MULTIMODAL_VL_RERANK_STAGE=global
MULTIMODAL_GLOBAL_VL_RERANK_TOP_N=16

# --- Experiência das legendas (2026-09-30): ramo texto→legendas nas perguntas visuais ---
# Vazio desliga. Índice do ../patrimonio360_caption_indexer (ex.: p360exp-1a2bf259341a-caption8b).
# replace = as legendas no lugar do texto→imagem; add = os dois. As fotografias não mudam.
CAPTION_TEXT_INDEX=
CAPTION_TEXT_MODE=replace
CAPTION_TEXT_WEIGHT=0.7

# --- Melhorias pós-estudo (2026-09-15) — ver docs/auditoria/PLANO_MELHORIAS.md ---
# O .env do estudo está guardado em .env.bak.estudo-20260915. Os logs do estudo
# (logs/evaluation/) ficam intactos: a produção escreve em logs/production/.
CHAT_ROUTER_MODE=deterministic
CHAT_DETERMINISTIC_SMALLTALK=true
CHAT_TEMPLATE_RESULTS_PAGE_REPLY=true
LLM_MAX_TOKENS_JSON=200
LLM_MAX_TOKENS_TEXT=450
CHAT_STREAM_FINAL_ANSWER=true
CHAT_COMPACT_ANSWER_CONTEXT=true
CHAT_INVENTORY_GRAMMAR_V2=true
CHAT_GROUNDING_CHECK=repair
CHAT_ENABLE_LLM_LEXICAL_QUERY=true
QUERY_LOG_COMPACT_VECTORS=true
# VL reranker desligado 2026-09-16: prejudica i2i (benchmark) e nao ajuda image+text de forma significativa; poupa ~1 s e 16 GB de download.

# --- LLM local (2026-09-16) — deploy/llm/amalia_llm.sh (vLLM, mesmo modelo que a API remota) ---
# Se o vLLM local recusar a ligação, o mesmo pedido vai à API remota.
LLM_FALLBACK_BASE_URL=https://api.novasearch.org/amalia-llm/v1/chat/completions
LLM_FALLBACK_MODEL=carminho/AMALIA-9B-50-DPO
LLM_CONNECT_TIMEOUT_SECONDS=3

# Miniaturas ?w= nas imagens do acervo (2026-09-16)
CHAT_IMAGE_THUMBNAILS=true
# Carrega os embedders no arranque (1.ª pergunta depois de reiniciar demorava 19,7 s)
CHAT_PREWARM_ON_STARTUP=true
# Vocabulário leigo -> catálogo (regras em app/config/lay_vocabulary.json)
CHAT_LAY_VOCABULARY_EXPANSION=true
# «Onde estou?» pela posição na visita (2026-09-16)
CHAT_TOUR_LOCATION_ANSWERS=true
CHAT_TOUR_CONTEXT_LLM_WORDING=true

# Peça selecionada: pedido independente liberta-a (2026-09-17)
CHAT_SELECTED_ARTIFACT_AUTO_RELEASE=true

# Peça implícita, sem botões nem etiquetas (2026-09-17)
CHAT_IMPLICIT_ARTIFACT_CONTEXT=true

# «Ver na tour»: metadata.intent = "describe_artifact" apresenta a peça selecionada sem pesquisa (2026-09-30)
CHAT_DESCRIBE_ARTIFACT_INTENT=true
# O modelo escolhe os cartões; pedido por nome ou n.º mostra só as peças que correspondem (2026-09-30)
CHAT_MODEL_SELECTS_CARDS=true
# Fichas iguais do mesmo conjunto (38195/1 a 38195/10) num só cartão; a pesquisa pede 3× candidatos (2026-09-30)
CHAT_COLLAPSE_SET_DUPLICATES=true
CHAT_COLLAPSE_FETCH_FACTOR=3
# Analítica do acervo por regras: mais antiga/recente, quantas, por século, autor com mais obras (2026-10-12)
CHAT_CATALOGUE_ANALYTICS=true
CHAT_CATALOGUE_ANALYTICS_CARDS=24
CHAT_CATALOGUE_ANALYTICS_LLM_WORDING=false
# Tesouros Nacionais pela lista em app/config/national_treasures.json (relida quando muda, sem reindexar):
# pesquisa filtrada à lista, marca nos cartões e regra no prompt (2026-10-15)
CHAT_NATIONAL_TREASURES=true
# Ditado por voz no servidor (WebSocket /api/v1/speech/stream): faster-whisper large-v3-turbo
# na GPU, carregado no arranque; desligado, o frontend usa o ditado do browser (2026-10-15)
SPEECH_STT_ENABLED=true

# --- Definições que o .env de produção não fixa: vale o valor por omissão do config.py.
# Os valores abaixo são só exemplos. LLM_FALLBACK_API_KEY vazio = usa o LLM_API_KEY.
# BACKEND_RAG_DEBUG_ENABLED=true
# BACKEND_RAG_DEBUG_MAX_CHARS=40000
# MULTIMODAL_TEXT_EMBEDDING_BATCH_SIZE=8
# MULTIMODAL_IMAGE_EMBEDDING_BATCH_SIZE=4
# TOUR_LOCATIONS_PATH=
# LLM_FALLBACK_API_KEY=
# IMAGE_THUMBNAIL_CACHE_DIR=
# CHAT_IMAGE_CACHE_MAX_AGE_SECONDS=86400
